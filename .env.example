# Copy this file to `.env` (which git ignores) and fill in the three values.
# The same three variables are set in Vercel → Project → Settings → Environment Variables.

# Your store's .myshopify.com address (not secret).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# The PRIVATE Storefront API token from Sales channels → Headless → your storefront.
# Read ONCE at build time to fetch products and platforms; never shipped to the browser.
# Treat it like a password. Never commit it; never paste it into chat.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# The PUBLIC Storefront API token from the same screen (Phase 5 — the cart).
# The PUBLIC_ prefix means it IS written into every web page: Shopify designed this
# token for that — it can only do shopper things (read products, build a cart).
# Never put the private token here; the build refuses if the two are the same.
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
