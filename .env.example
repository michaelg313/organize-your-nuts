# Copy this file to `.env` (which git ignores) and fill in the two values.
# The same two variables are set in Vercel → Project → Settings → Environment Variables.
#
# The build reads these ONCE, at build time, to fetch products and platforms from
# Shopify's Storefront API. Nothing here is shipped to the browser.

# Your store's .myshopify.com address (not secret).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# The PRIVATE Storefront API token from Sales channels → Headless → your storefront.
# Treat it like a password. Never commit it; never paste it into chat.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
