---
/**
 * Site.astro — the app shell: <head>, sticky nav, footer, and the `.page`
 * wrapper that is the container-query root for every responsive rule
 * (ADR-001 §5 Phase 1). Markup follows the hi-fi's per-frame chrome.
 *
 * Every route the nav and footer link to exists as of Phase 6.
 *
 * Every page carries the cart's Storefront settings in <head> (the PUBLIC
 * token — see storefrontPublicConfig() in shopify.js) because the nav's cart
 * count is on every page (src/scripts/cart-count.js).
 *
 * Phase 6: the ☰ menu works at phone width (src/scripts/nav-menu.js), and the
 * footer lists every platform page on every page (it was kits-only). Things
 * the hi-fi didn't design live in shared/site-additions.css, loaded right
 * after site.css, which stays byte-for-byte the hi-fi.
 */
import "../styles/site.css";
import "../styles/shared/site-additions.css";
import { storefrontPublicConfig } from "../lib/shopify.js";
import { platforms } from "../lib/fitment.js";
import { business } from "../lib/business.js";

interface Props {
  /** <title> — page-specific, complete. */
  title: string;
  /** <meta name="description"> */
  description: string;
  /** Absolute canonical URL for this page. */
  canonical: string;
  /** Which nav item is current. */
  current?: "home" | "kits" | "storage" | "about";
}
const { title, description, canonical, current } = Astro.props;
const on = (key: string) => (current === key ? { class: "on", "aria-current": "page" } : {});
const storefront = storefrontPublicConfig();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="oyn-storefront-endpoint" content={storefront.endpoint} />
  <meta name="oyn-storefront-token" content={storefront.token} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
<div class="page">
  <span class="nav-sentinel" aria-hidden="true"></span>
  <header class="nav">
    <div class="nav-inner">
      <a class="logo" href="/"><span class="mark" aria-hidden="true">O</span><span class="word">OrganizeYour<span>Nuts</span></span></a>
      <nav class="nav-links" id="site-nav" aria-label="Main">
        <a href="/" {...on("home")}>Home</a>
        <a href="/hardware-kits" {...on("kits")}>Hardware Kits</a>
        <a href="/hardware-storage" {...on("storage")}>Hardware Storage</a>
        <a href="/about" {...on("about")}>About / Contact</a>
      </nav>
      <div class="nav-right">
        <a class="cart-btn" href="/cart" aria-label="Cart" data-cart-link><span class="lbl">Cart</span> <span class="count" data-cart-count hidden></span></a>
        <button class="hamburger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">☰</button>
      </div>
    </div>
  </header>

  <slot />

  <!-- announces cart changes ("… added to your cart") to screen readers -->
  <p class="vh" role="status" data-cart-status></p>

  <footer class="footer">
    <div class="wrap">
      <h2 class="vh">Site links</h2>
      <div class="foot-grid">
        <div>
          <a class="logo" href="/" style="margin-bottom:14px;"><span class="mark" aria-hidden="true">O</span><span class="word">OrganizeYour<span>Nuts</span></span></a>
          <p class="muted" style="max-width:34ch;">Automotive fastener kits and hardware storage{business.shipsFrom ? `, shipped from ${business.shipsFrom.state}` : ""}.</p>
        </div>
        <div><h3>Hardware Kits</h3><ul>
          <li><a href="/hardware-kits">Shop by vehicle</a></li>
          {platforms.map((p) => <li><a href={`/hardware-kits/${p.handle}`}>{p.display_name}</a></li>)}
        </ul></div>
        <div><h3>Storage</h3><ul>
          <li><a href="/hardware-storage/bins">Bins</a></li>
          <li><a href="/hardware-storage/organizers">Organizers</a></li>
          <li><a href="/hardware-storage/cases">Cases</a></li>
        </ul></div>
        <div><h3>Company</h3><ul>
          <li><a href="/about">About us</a></li>
          <li><a href="/about#contact">Contact</a></li>
          <li><a href="/cart">Cart</a></li>
        </ul></div>
      </div>
      <div class="foot-bottom">
        <span>&copy; 2026 OrganizeYourNuts.com</span>
        <span>Shipping &middot; Returns &middot; Privacy</span>
      </div>
    </div>
  </footer>
</div>

<script>
  /* Nav: frosted → solid past 20px of scroll. Ported unchanged from the hi-fi:
     a 1px sentinel sits directly above the sticky nav; when it leaves the top
     of the viewport the nav has begun sticking, so it goes solid. */
  (function () {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const nav = e.target.nextElementSibling;
          if (nav) nav.classList.toggle("solid", !e.isIntersecting);
        }
      },
      { rootMargin: "-20px 0px 0px 0px", threshold: 0 },
    );
    document.querySelectorAll(".nav-sentinel").forEach((s) => io.observe(s));
  })();
</script>
<script src="../scripts/cart-count.js"></script>
<script src="../scripts/nav-menu.js"></script>
</body>
</html>
