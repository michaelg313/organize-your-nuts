---
/**
 * /about — About / Contact (hi-fi template ⑦ and its "validation errors"
 * state, ADR-001 §5 Phase 6).
 *
 * Copy: every business fact (returns, shipping, materials, where it ships
 * from, phone, hours, address) comes from src/lib/business.js and is left off
 * until confirmed. Numbers about the catalog are counted from the real data.
 *
 * The contact form (src/scripts/contact-form.js) checks the fields in the
 * browser the way the hi-fi's error state shows, then sends through Formspree
 * (operator's decision, Phase 6) — the site stays fully static (ADR-002).
 * How it sends depends on business.js:
 *   contactFormEndpoint set → Formspree emails the message to the operator
 *   only `email` set        → opens the shopper's email app, message pre-written
 *   neither                 → the form says it isn't connected yet (and the build warns)
 */
import Site from "../layouts/Site.astro";
import { loadCatalog } from "../lib/shopify.js";
import { platforms, vehicleCount } from "../lib/fitment.js";
import { business, contactMode } from "../lib/business.js";
import "../styles/pages/about.css";

const { kits } = await loadCatalog();
const canonical = new URL("/about", Astro.site).href;
const b = business;
const mode = contactMode();
if (!mode) {
  console.warn(
    "⚠ The About page's contact form isn't connected yet, so it can't send anything. " +
    "Put the Formspree form address (contactFormEndpoint) or a real mailbox (email) in src/lib/business.js.",
  );
}

// "Kits, not guesswork" — the first paragraph is how the site works (true by construction);
// the rest is business facts, each only if confirmed.
const madeFrom = [
  b.factoryFastenerList &&
    "Every kit is assembled against the factory fastener list for the vehicle it’s built for — right thread pitch, right grade, right count, with the odd trim clips nobody remembers until the panel is off.",
  b.kitMaterials && b.shipsFrom && `We stock ${b.kitMaterials} in the sizes that actually come up on the bench, and we ship them from ${b.shipsFrom.city}, ${b.shipsFrom.state}.`,
  b.kitMaterials && !b.shipsFrom && `We stock ${b.kitMaterials} in the sizes that actually come up on the bench.`,
  !b.kitMaterials && b.shipsFrom && `We ship every order from ${b.shipsFrom.city}, ${b.shipsFrom.state}.`,
].filter(Boolean).join(" ");

// Three stat cards: confirmed business facts first, then true counts.
const stats = [
  { b: String(kits.length), s: "Kits, each matched to its engine platform" },
  b.returnsDays && { b: `${b.returnsDays} days`, s: "Free returns, for any reason" },
  b.sameDayCutoff && { b: "Same day", s: `Shipping before ${b.sameDayCutoff}` },
  { b: String(platforms.length), s: "Engine platforms covered" },
  { b: vehicleCount().toLocaleString("en-US"), s: "Vehicles covered, by year, model and engine" },
].filter(Boolean).slice(0, 3);

// "Reach us directly" shows only confirmed rows; with none, the form gets the full width.
const hasDetails = Boolean(b.email || b.phone || b.hours || b.address || b.bulkPricingFrom);

const formAction = mode === "formspree" ? b.contactFormEndpoint : mode === "email" ? `mailto:${b.email}` : undefined;
---
<Site
  title="About & Contact | OrganizeYourNuts"
  description="Who we are, how our kits are matched to your vehicle, and how to reach us — tell us the year, model and engine and what you’re rebuilding."
  {canonical}
  current="about"
>
  <section class="sec tight">
    <div class="wrap">
      <div class="crumb"><a href="/">Home</a><span>/</span><b>About / Contact</b></div>
      <p class="eyebrow">Who we are</p>
      <h1 class="h1-page">Built by people who&rsquo;ve hunted for one missing bolt</h1>
      <p class="lede">We started OrganizeYourNuts because finishing a rebuild shouldn&rsquo;t mean three trips to the parts store for hardware nobody stocks as a set.</p>
    </div>
  </section>

  <section class="sec" style="padding-top:10px;">
    <div class="wrap">
      <div class="about-grid">
        <div class="ph ph-shop" role="img" aria-label="Placeholder: Shop photo" data-label="Shop photo · 4:5"></div>
        <div>
          <h2>Kits, not guesswork</h2>
          <p class="muted" style="font-size:15px; line-height:1.75; margin-top:14px;">Kits are matched to engine platforms, not guessed from a parts catalog. Pick your year, make, model and engine and you see only the kits that fit it &mdash; and where a kit doesn&rsquo;t fit every vehicle on its platform, the kit says so before you order.</p>
          {madeFrom && <p class="muted" style="font-size:15px; line-height:1.75; margin-top:14px;">{madeFrom}</p>}
          {b.returnsDays && <p class="muted" style="font-size:15px; line-height:1.75; margin-top:14px;">Kit doesn&rsquo;t fit what you&rsquo;re working on, or just changed your mind? Send it back inside {b.returnsDays} days, for any reason &mdash; returns are free. We&rsquo;d rather you get the right hardware than keep the wrong box.</p>}
          <div class="stat-row">
            {stats.map((st) => <div class="card stat"><b>{st.b}</b><span>{st.s}</span></div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec alt" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Get in touch</p>
        <h2 id="contact-h">Tell us what you&rsquo;re building</h2>
        <p class="lede">Give us the year, model and engine, and what you&rsquo;re rebuilding. We&rsquo;ll come back with the kits that fit.</p>
      </div>
      <div class:list={["contact-grid", { solo: !hasDetails }]}>
        <form class="card" style="padding:26px;" data-contact data-mode={mode ?? ""} data-email={b.email ?? ""}
          action={formAction} method="post" enctype={mode === "email" ? "text/plain" : undefined} novalidate>
          <div class="alert" role="alert" data-contact-alert hidden>
            <span class="amark" aria-hidden="true">!</span>
            <p data-contact-alert-text></p>
          </div>
          <div class="notice" role="status" data-contact-note hidden>
            <span class="nmark" aria-hidden="true">i</span>
            <p data-contact-note-text></p>
          </div>
          {!mode && (
            <div class="notice">
              <span class="nmark" aria-hidden="true">!</span>
              <p>Our contact form isn&rsquo;t connected yet, so it can&rsquo;t send messages.</p>
            </div>
          )}
          <div class="form-grid">
            <label class="field"><span class="lab">Name</span>
              <input class="ctl" id="contact-name" name="name" type="text" autocomplete="name" placeholder="Your name" aria-describedby="e-name" data-label="name" />
              <span class="err" id="e-name" hidden></span>
            </label>
            <label class="field"><span class="lab">Email</span>
              <input class="ctl" id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="e-email" data-label="email address" />
              <span class="err" id="e-email" hidden></span>
            </label>
            <label class="field span2"><span class="lab">Message</span>
              <textarea class="ctl" id="contact-message" name="message" placeholder="2016 Silverado, 5.3L — rebuilding the top end and need head and intake hardware." aria-describedby="e-message" data-label="message"></textarea>
              <span class="err" id="e-message" hidden></span>
            </label>
          </div>
          {mode === "formspree" && (
            <>
              <input type="hidden" name="_subject" value="New message from organizeyournuts.com" />
              <!-- spam trap: people never see or fill this; bots do, and Formspree drops those -->
              <input type="text" name="_gotcha" class="vh" tabindex="-1" autocomplete="off" aria-hidden="true" />
            </>
          )}
          <button class="btn btn-primary btn-block" type="submit" style="margin-top:20px;" data-contact-submit disabled={!mode}>Send message</button>
          <p class="muted" style="font-size:12px; margin-top:13px;">We reply by email.</p>
        </form>

        <div class="card" style="padding:26px;" data-contact-sent hidden tabindex="-1">
          <div class="notice" role="status" style="margin-bottom:0;">
            <span class="nmark" aria-hidden="true">&#10003;</span>
            <p><b>Thanks &mdash; your message is on its way.</b> We&rsquo;ll reply by email.</p>
          </div>
        </div>

        {hasDetails && (
          <aside class="card" style="padding:26px;">
            <h3 style="margin-bottom:10px;">Reach us directly</h3>
            {b.email && <div class="detail"><div class="dk">Email</div><div class="dv"><a href={`mailto:${b.email}`}>{b.email}</a></div></div>}
            {b.phone && <div class="detail"><div class="dk">Phone</div><div class="dv"><a href={`tel:${b.phone.tel}`}>{b.phone.display}</a></div></div>}
            {b.hours && <div class="detail"><div class="dk">Hours</div><div class="dv">{b.hours.map((line, i) => <>{i > 0 && <br />}{line}</>)}</div></div>}
            {b.address && <div class="detail"><div class="dk">Warehouse</div><div class="dv">{b.address.map((line, i) => <>{i > 0 && <br />}{line}</>)}</div></div>}
            {b.bulkPricingFrom && <div class="detail"><div class="dk">Bulk orders</div><div class="dv">{b.bulkPricingFrom}+ kits? Ask about tiered pricing.</div></div>}
          </aside>
        )}
      </div>
    </div>
  </section>
</Site>

<script src="../scripts/contact-form.js"></script>
