---
/**
 * KitCard.astro — one kit, as the hi-fi's `.card.card-lift.prod`, plus the two
 * fitment lines ADR-003 §5.3 requires:
 *   - `custom.fitment_note`, rendered prominently when the kit has one
 *   - the general "verify fitment before ordering" line, on every kit card
 *
 * "Add to cart" (Phase 5) is wired up by src/scripts/add-to-cart.js. The HTML
 * shows the stock state as of the build ("Out of stock" when Shopify said the
 * kit can't be sold); the script re-asks Shopify when the page loads, so a
 * restock in the admin turns the button on without a redeploy.
 */
import { formatPrice } from "../lib/shopify.js";

interface Props {
  kit: import("../lib/shopify.js").Kit;
}
const { kit } = Astro.props;
---
<article class="card card-lift prod">
  {kit.image
    ? <img class="kit-photo" src={kit.image.url} alt={kit.image.alt} width={kit.image.width} height={kit.image.height} loading="lazy" decoding="async" />
    : <div class="ph ph-kit" role="img" aria-label="Placeholder: Kit photo" data-label="Kit photo · 4:3"></div>}
  <h4 class="name">{kit.title}</h4>
  {kit.description && <p class="desc">{kit.description}</p>}
  {kit.fitmentNote && (
    <div class="fit-note">
      <span class="fmark" aria-hidden="true">!</span>
      <div><b>Check before ordering</b>{kit.fitmentNote}</div>
    </div>
  )}
  <p class="fit-verify">Verify fitment before ordering — kits fit the platform, not every option ever built on it. Not sure? <a href="/about">Ask us</a>.</p>
  <div class="buy">
    <span class="price">{formatPrice(kit.price)}</span>
    <button class="btn btn-primary btn-sm" type="button"
      data-add-to-cart data-variant={kit.variantId} data-title={kit.title}
      disabled={!kit.availableForSale} aria-disabled={kit.availableForSale ? undefined : "true"}
    >{kit.availableForSale ? "Add to cart" : "Out of stock"}</button>
  </div>
  <p class="err" data-add-error hidden></p>
</article>
